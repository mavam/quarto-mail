#!/usr/bin/env python3
"""Offline Gmail transport for the render-and-send integration tests."""

import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
call = {"args": args}
if "--raw-file" in args:
    source = args[args.index("--raw-file") + 1]
    call["raw"] = sys.stdin.buffer.read().decode("latin-1") if source == "-" else Path(source).read_text()
if os.environ.get("FAKE_GOG_LOG"):
    with Path(os.environ["FAKE_GOG_LOG"]).open("a") as log:
        log.write(json.dumps(call) + "\n")
if os.environ.get("FAKE_GOG_FAIL"):
    print("synthetic Gmail failure", file=sys.stderr)
    raise SystemExit(7)
if "show" in args:
    assert "--readonly" in args
    # gog reports a fetched message inside an envelope.
    print(json.dumps({"headers": {}, "message": json.loads(Path(os.environ["FAKE_GMAIL_RESPONSE"]).read_text())}))
elif "drafts" in args:
    print('{"draftId":"draft-result-123","message":{"id":"result-123","threadId":"thread-456"},"threadId":"thread-456"}')
elif "send" in args:
    print('{"from":"work@example.com","messageId":"result-123","threadId":"thread-456"}')
else:
    raise SystemExit("unexpected gog command")
